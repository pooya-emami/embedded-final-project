[Unit]
Description=Security Server
After=relay.service detection.service mosquitto.service
Requires=relay.service detection.service mosquitto.service

[Service]
Type=simple
User=pooya
WorkingDirectory=/home/pooya/embproj/proj/src/server
ExecStart=/usr/local/bin/security_server
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target